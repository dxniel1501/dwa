{
  "schemaVersion": 1,
  "id": "survival-addon",
  "version": "${version}",
  "name": "Survival Addon",
  "description": "Freecam mit Interaktion, Activity-Finder und Nametags fuer Meteor Client.",
  "authors": [
    "du"
  ],
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "de.survival.addon.SurvivalAddon"
    ]
  },
  "custom": {
